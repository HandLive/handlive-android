<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- SET-01 part B, requested together when calls are turned on (SET-01 API 2, C12): the call state and the SIMs,
         the incoming number (the PHONE_STATE broadcast carries it only with READ_CALL_LOG) and the call log, answering,
         declining and ending through TelecomManager, and contact names. No InCallService. -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <uses-permission android:name="android.permission.ANSWER_PHONE_CALLS" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />

    <!-- Calls work only on phones with telephony; the app still installs on others (SET-01 step 8: "unsupported"). -->
    <uses-feature
        android:name="android.hardware.telephony"
        android:required="false" />

    <!-- CALL-05: the apps with an InCallService are cellular dialers, whose call notifications are never app calls;
         the listener must see them to drop them. -->
    <queries>
        <intent>
            <action android:name="android.telecom.InCallService" />
        </intent>
    </queries>

    <application>
        <!-- CALL-05: calls of other apps (Telegram…) from their call notifications. The user grants "Notification
             access" by hand (SET-01 primer); only call notifications are ever read, the rest is ignored. -->
        <service
            android:name=".appcall.AppCallListenerService"
            android:exported="false"
            android:label="@string/common_app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
