<?xml version="1.0" encoding="utf-8"?>
<!--
  W3: a separate service with window content, limited to the supported browsers (packageNames), two event types,
  notification timeout 500 ms. flagReportViewIds exposes the view ids the adapters look for. canTakeScreenshot is a
  spike-only probe for FLAG_SECURE windows on API 34+ (the screenshot is discarded, only the error code is read).
  Keep packageNames in step with Browser in BrowserAdapter.kt (a unit test checks it).
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged|typeWindowContentChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagReportViewIds"
    android:canRetrieveWindowContent="true"
    android:canTakeScreenshot="true"
    android:description="@string/service_description"
    android:isAccessibilityTool="false"
    android:notificationTimeout="500"
    android:packageNames="com.android.chrome,com.sec.android.app.sbrowser,org.mozilla.firefox,com.microsoft.emmx,com.brave.browser,com.opera.browser,com.vivaldi.browser,com.duckduckgo.mobile.android"
    android:settingsActivity="app.handlive.spike.web.ui.SpikeActivity" />
